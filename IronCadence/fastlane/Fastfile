# Builds Iron Cadence in CI and uploads it to TestFlight. No Mac required.
#
# Signing uses fastlane match: on the first run it creates an Apple Distribution
# certificate and App Store provisioning profile through the App Store Connect API,
# encrypts them with MATCH_PASSWORD, and stores them on a branch of this repository.
# Later runs reuse them.
#
# Required environment (GitHub Actions secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID                      App Store Connect API key (Admin role)
#   ASC_KEY_P8 (pasted text) or ASC_KEY_P8_BASE64  contents of the downloaded .p8 key
#   APPLE_TEAM_ID                                  10-character Team ID
#   APP_BUNDLE_ID                                  e.g. com.yourname.ironcadence
#   MATCH_PASSWORD                                 any strong passphrase (keep it safe)
#   GITHUB_TOKEN, MATCH_GIT_URL                    provided by the workflow

require "base64"

default_platform(:ios)

platform :ios do
  desc "Build, sign and upload to TestFlight"
  lane :beta do
    setup_ci # temporary keychain on the CI runner

    # Accept the .p8 key either as pasted text (ASC_KEY_P8) or base64 (ASC_KEY_P8_BASE64).
    raw_key = ENV["ASC_KEY_P8"].to_s.strip
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: raw_key.empty? ? ENV.fetch("ASC_KEY_P8_BASE64") : raw_key,
      is_key_content_base64: raw_key.empty?,
      in_house: false
    )

    bundle_id = ENV.fetch("APP_BUNDLE_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    match(
      type: "appstore",
      app_identifier: bundle_id,
      team_id: team_id,
      api_key: api_key,
      storage_mode: "git",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "fastlane-signing",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('GITHUB_TOKEN')}"),
      readonly: false
    )

    profile = ENV["sigh_#{bundle_id}_appstore_profile-name"]

    build_app(
      project: "IronCadence.xcodeproj",
      scheme: "IronCadence",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: [
        "PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id}",
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile}'",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')}"
      ].join(" "),
      export_options: {
        provisioningProfiles: { bundle_id => profile }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "Iron Cadence build #{ENV.fetch('BUILD_NUMBER', '1')}"
    )
  end
end
